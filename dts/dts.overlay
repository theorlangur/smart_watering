#include "partitions.dtsi"
#include "zigbee_partitions.dtsi"
#include "usb_uart.dtsi"
#include "buttons.dtsi"
#include "pump.dtsi"
#include "pressure.dtsi"
#include "soil.dtsi"
#include "aem13921.dtsi"

/ {
	chosen {
		ncs,zigbee-timer = &timer20;
		zephyr,code-partition = &slot0_partition;
		zephyr,console = &uart00;
	};

	zephyr,user {
		io-channels = <&adc 0>, <&adc 1>;
		io-channel-names = "pump_current", "pressure";
	};

	aliases {
	};

	cpuapp_sram@2002e800 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x2002e800 DT_SIZE_K(2)>;
		zephyr,memory-region = "BreadcrumbsMem";
		status = "okay";
		retainedmem {
			compatible = "zephyr,retained-ram";
			status = "okay";
		};
	};

};

&timer20 {
	status = "okay";
};

&pinctrl {
	//i2c sensor bus
	/omit-if-no-ref/ i2c21_default: i2c21_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 6)>,
				<NRF_PSEL(TWIM_SCL, 1, 5)>;
		};
	};

	/omit-if-no-ref/ i2c21_sleep: i2c21_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 6)>,
				<NRF_PSEL(TWIM_SCL, 1, 5)>;
			low-power-enable;
		};
	};
};

&i2c21 {
	status = "okay";
	pinctrl-0 = <&i2c21_default>;
	pinctrl-1 = <&i2c21_sleep>;
	pinctrl-names = "default", "sleep";
};


&cpuapp_sram {
	/* Shrink SRAM size to avoid overlap with retained memory region */
	reg = <0x20000000 DT_SIZE_K(186)>;
	ranges = <0x0 0x20000000 0x2e800>;
};
