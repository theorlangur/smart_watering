#include "../dts/partitions.dtsi"
#include "../dts/usb_uart.dtsi"
/ {
	chosen {
		zephyr,code-partition = &boot_partition;
		zephyr,uart-mcumgr = &uart00;
	};

	buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&gpio0 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Button 1";
		};
	};

	aliases {
		mcuboot-button0 = &button0;
	};
};

&gpio2 {
	status = "okay";
};

&gpio0 {
	status = "okay";
};
